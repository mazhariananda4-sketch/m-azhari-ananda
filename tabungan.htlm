<!-- Toast -->
<div class="toast" id="toast">
  <i class="lucide lucide-check-circle" style="color: var(--emerald);"></i>
  <span id="toastMsg">Berhasil</span>
</div>

<script>
  // ============ ANIMATE BALANCE COUNTER ============
  function animateValue(el, start, end, duration) {
    const startTime = performance.now();
    const update = (now) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(start + (end - start) * eased);
      el.textContent = current.toLocaleString('id-ID');
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }
  
  setTimeout(() => {
    animateValue(document.getElementById('totalBalance'), 0, 16720000, 2000);
  }, 200);
  
  // ============ BALANCE MINI CHART ============
  const ctxBalance = document.getElementById('balanceChart').getContext('2d');
  const gradient1 = ctxBalance.createLinearGradient(0, 0, 0, 150);
  gradient1.addColorStop(0, 'rgba(16, 217, 160, 0.4)');
  gradient1.addColorStop(1, 'rgba(16, 217, 160, 0)');
  
  new Chart(ctxBalance, {
    type: 'line',
    data: {
      labels: ['Sep', 'Okt', 'Nov', 'Des', 'Jan'],
      datasets: [{
        data: [11.2, 12.8, 13.5, 14.9, 16.7],
        borderColor: '#10d9a0',
        borderWidth: 2.5,
        backgroundColor: gradient1,
        fill: true,
        tension: 0.4,
        pointRadius: 0,
        pointHoverRadius: 6,
        pointHoverBackgroundColor: '#10d9a0',
        pointHoverBorderColor: '#fff',
        pointHoverBorderWidth: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: {
        backgroundColor: 'rgba(13, 19, 34, 0.95)',
        titleColor: '#8a93a8',
        bodyColor: '#e8ecf4',
        borderColor: 'rgba(16,217,160,0.3)',
        borderWidth: 1,
        padding: 12,
        displayColors: false,
        callbacks: {
          label: (ctx) => 'Rp ' + (ctx.parsed.y * 1000000).toLocaleString('id-ID')
        }
      }},
      scales: {
        x: { display: false },
        y: { display: false }
      },
      interaction: { intersect: false, mode: 'index' }
    }
  });
  
  // ============ GROWTH CHART ============
  const ctxGrowth = document.getElementById('growthChart').getContext('2d');
  const gradient2 = ctxGrowth.createLinearGradient(0, 0, 0, 280);
  gradient2.addColorStop(0, 'rgba(16, 217, 160, 0.35)');
  gradient2.addColorStop(1, 'rgba(16, 217, 160, 0)');
  
  const gradient3 = ctxGrowth.createLinearGradient(0, 0, 0, 280);
  gradient3.addColorStop(0, 'rgba(251, 191, 36, 0.2)');
  gradient3.addColorStop(1, 'rgba(251, 191, 36, 0)');
  
  new Chart(ctxGrowth, {
    type: 'line',
    data: {
      labels: ['Agus', 'Sep', 'Okt', 'Nov', 'Des', 'Jan'],
      datasets: [
        {
          label: 'Saldo',
          data: [8.5, 10.2, 11.2, 12.8, 13.5, 16.7],
          borderColor: '#10d9a0',
          borderWidth: 3,
          backgroundColor: gradient2,
          fill: true,
          tension: 0.4,
          pointRadius: 0,
          pointHoverRadius: 7,
          pointHoverBackgroundColor: '#10d9a0',
          pointHoverBorderColor: '#fff',
          pointHoverBorderWidth: 2,
        },
        {
          label: 'Target Ideal',
          data: [9, 10, 11, 12.5, 14, 15.5],
          borderColor: '#fbbf24',
          borderWidth: 2,
          borderDash: [5, 5],
          backgroundColor: gradient3,
          fill: false,
          tension: 0.4,
          pointRadius: 0,
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true,
          position: 'top',
          align: 'end',
          labels: {
            color: '#8a93a8',
            usePointStyle: true,
            pointStyle: 'circle',
            padding: 16,
            font: { size: 12, family: 'Plus Jakarta Sans' }
          }
        },
        tooltip: {
          backgroundColor: 'rgba(13, 19, 34, 0.95)',
          titleColor: '#8a93a8',
          bodyColor: '#e8ecf4',
          borderColor: 'rgba(255,255,255,0.1)',
          borderWidth: 1,
          padding: 12,
          callbacks: {
            label: (ctx) => ctx.dataset.label + ': Rp ' + (ctx.parsed.y * 1000000).toLocaleString('id-ID')
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#5d6479', font: { size: 11 } }
        },
        y: {
          grid: { color: 'rgba(255,255,255,0.04)' },
          ticks: {
            color: '#5d6479',
            font: { size: 11 },
            callback: (v) => 'Rp ' + v + 'jt'
          }
        }
      },
      interaction: { intersect: false, mode: 'index' }
    }
  });
  
  // ============ CATEGORY DOUGHNUT CHART ============
  const ctxCat = document.getElementById('categoryChart').getContext('2d');
  new Chart(ctxCat, {
    type: 'doughnut',
    data: {
      labels: ['Dana Darurat', 'Liburan', 'Investasi', 'Pendidikan', 'Lainnya'],
      datasets: [{
        data: [42, 24, 18, 11, 5],
        backgroundColor: ['#10d9a0', '#fbbf24', '#a78bfa', '#38bdf8', '#ff6b6b'],
        borderColor: '#131a2c',
        borderWidth: 3,
        hoverOffset: 8,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '70%',
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: 'rgba(13, 19, 34, 0.95)',
          titleColor: '#8a93a8',
          bodyColor: '#e8ecf4',
          borderColor: 'rgba(255,255,255,0.1)',
          borderWidth: 1,
          padding: 12,
          callbacks: {
            label: (ctx) => ctx.label + ': ' + ctx.parsed + '%'
          }
        }
      }
    }
  });
  
  // ============ TRANSACTIONS DATA ============
  const transactions = [
    { icon: 'arrow-down-circle', color: 'emerald', title: 'Setor Tabungan Otomatis', cat: 'Dana Darurat', date: 'Hari ini · 09:24', amount: 1500000, type: 'in' },
    { icon: 'shopping-cart', color: 'coral', title: 'Belanja Bulanan', cat: 'Kebutuhan', date: 'Hari ini · 07:15', amount: 487000, type: 'out' },
    { icon: 'coffee', color: 'gold', title: 'Kopi Senja', cat: 'Lifestyle', date: 'Kemarin · 16:42', amount: 45000, type: 'out' },
    { icon: 'gift', color: 'violet', title: 'Bonus Referral', cat: 'Income', date: 'Kemarin · 14:20', amount: 250000, type: 'in' },
    { icon: 'fuel', color: 'sky', title: 'Isi Bensin', cat: 'Transport', date: '12 Jan · 18:30', amount: 120000, type: 'out' },
    { icon: 'arrow-down-circle', color: 'emerald', title: 'Setor Manual', cat: 'Investasi', date: '11 Jan · 10:00', amount: 800000, type: 'in' },
    { icon: 'utensils', color: 'coral', title: 'Makan Siang', cat: 'Lifestyle', date: '10 Jan · 12:15', amount: 38000, type: 'out' },
  ];
  
  const colorMap = {
    emerald: { bg: 'rgba(16,217,160,0.15)', fg: '#10d9a0' },
    gold: { bg: 'rgba(251,191,36,0.15)', fg: '#fbbf24' },
    coral: { bg: 'rgba(255,107,107,0.15)', fg: '#ff6b6b' },
    violet: { bg: 'rgba(167,139,250,0.15)', fg: '#a78bfa' },
    sky: { bg: 'rgba(56,189,248,0.15)', fg: '#38bdf8' },
  };
  
  const txList = document.getElementById('transactionList');
  transactions.forEach((tx, i) => {
    const c = colorMap[tx.color];
    const item = document.createElement('div');
    item.className = 'tx-item flex items-center gap-4 p-3 rounded-xl';
    item.style.animationDelay = (0.05 * i) + 's';
    item.innerHTML = `
      <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style="background: ${c.bg};">
        <i class="lucide lucide-${tx.icon}" style="color: ${c.fg};"></i>
      </div>
      <div class="flex-1 min-w-0">
        <div class="font-semibold text-sm truncate">${tx.title}</div>
        <div class="text-xs flex items-center gap-2 mt-0.5" style="color: var(--muted);">
          <span>${tx.cat}</span><span>·</span><span>${tx.date}</span>
        </div>
      </div>
      <div class="text-right flex-shrink-0">
        <div class="display font-bold text-sm" style="color: ${tx.type === 'in' ? '#10d9a0' : '#e8ecf4'};">
          ${tx.type === 'in' ? '+' : '−'} Rp ${tx.amount.toLocaleString('id-ID')}
        </div>
        <div class="text-xs" style="color: var(--muted-2);">${tx.type === 'in' ? 'Pemasukan' : 'Pengeluaran'}</div>
      </div>
    `;
    txList.appendChild(item);
  });
  
  // ============ STREAK CALENDAR ============
  const streakCal = document.getElementById('streakCalendar');
  const days = 28;
  const today = 26;
  for (let i = 0; i < days; i++) {
    const day = document.createElement('div');
    day.className = 'streak-day';
    if (i < today) day.classList.add('active');
    if (i === today) day.classList.add('today');
    streakCal.appendChild(day);
  }
  
  // ============ MODAL ============
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }
  
  function setQuickAmount(amount) {
    document.getElementById('topupAmount').value = amount.toLocaleString('id-ID');
  }
  
  function submitTopUp() {
    const amount = document.getElementById('topupAmount').value;
    showToast('Berhasil menabung Rp ' + amount + ' 🎉');
    closeModal('topupModal');
  }
  
  // ============ TOAST ============
  function showToast(msg) {
    const toast = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }
  
  // ============ TAB SWITCH ============
  function switchTab(btn, period) {
    btn.parentElement.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    showToast('Periode: ' + period);
  }
  
  // ============ SIDEBAR NAV ============
  document.querySelectorAll('.sidebar-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
    });
  });
  
  // ============ KEYBOARD SHORTCUT ============
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-backdrop.active').forEach(m => m.classList.remove('active'));
    }
    if (e.key === 'n' && !e.target.matches('input, select, textarea')) {
      openModal('topupModal');
    }
  });
</script>

</body>
</html>
