      <input type="text" id="topupAmount" class="input-field pl-12 display text-2xl font-bold" placeholder="0" value="500.000">
    </div>
    
    <div class="grid grid-cols-4 gap-2 mb-6">
      <button class="btn-ghost text-sm py-2" onclick="setQuickAmount(100000)">100rb</button>
      <button class="btn-ghost text-sm py-2" onclick="setQuickAmount(500000)">500rb</button>
      <button class="btn-ghost text-sm py-2" onclick="setQuickAmount(1000000)">1jt</button>
      <button class="btn-ghost text-sm py-2" onclick="setQuickAmount(2000000)">2jt</button>
    </div>
    
    <label class="text-xs font-semibold uppercase tracking-wider" style="color: var(--muted);">Kategori</label>
    <select class="input-field mt-2 mb-6">
      <option>Dana Darurat</option>
      <option>Liburan</option>
