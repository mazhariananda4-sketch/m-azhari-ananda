<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TabungKu — Dashboard Tabungan Pintar</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lucide-static@0.344.0/font/lucide.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0f1c;
    --bg-2: #0d1322;
    --card: #131a2c;
    --card-2: #1a2236;
    --border: rgba(255,255,255,0.06);
    --border-strong: rgba(255,255,255,0.1);
    --fg: #e8ecf4;
    --muted: #8a93a8;
    --muted-2: #5d6479;
    --emerald: #10d9a0;
    --emerald-dim: #0a8f6c;
    --gold: #fbbf24;
    --gold-dim: #b8860b;
    --coral: #ff6b6b;
    --violet: #a78bfa;
    --sky: #38bdf8;
  }
  
  * { box-sizing: border-box; }
  
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--bg);
    color: var(--fg);
    margin: 0;
    overflow-x: hidden;
    min-height: 100vh;
  }
  
  /* Atmospheric background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: 
      radial-gradient(ellipse 800px 600px at 10% 10%, rgba(16, 217, 160, 0.08), transparent 60%),
      radial-gradient(ellipse 700px 500px at 90% 90%, rgba(251, 191, 36, 0.06), transparent 60%),
      radial-gradient(ellipse 600px 400px at 50% 50%, rgba(167, 139, 250, 0.04), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }
  
  .display { font-family: 'Space Grotesk', sans-serif; }
  
  /* Scrollbar */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }
  
  /* Glass cards */
  .glass {
    background: linear-gradient(135deg, rgba(19,26,44,0.85), rgba(13,19,34,0.85));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border);
    border-radius: 20px;
  }
  
  .glass-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .glass-hover:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.4);
  }
  
  /* Glow effects */
  .glow-emerald { box-shadow: 0 0 0 1px rgba(16,217,160,0.3), 0 10px 40px -10px rgba(16,217,160,0.3); }
  .glow-gold { box-shadow: 0 0 0 1px rgba(251,191,36,0.3), 0 10px 40px -10px rgba(251,191,36,0.25); }
  
  /* Hero balance card */
  .hero-card {
    background: 
      radial-gradient(circle at 0% 0%, rgba(16,217,160,0.15), transparent 50%),
      radial-gradient(circle at 100% 100%, rgba(251,191,36,0.1), transparent 50%),
      linear-gradient(135deg, #0f1828 0%, #131a2c 100%);
    position: relative;
    overflow: hidden;
  }
  
  .hero-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(16,217,160,0.2), transparent 70%);
    filter: blur(40px);
    animation: float 8s ease-in-out infinite;
  }
  
  .hero-card::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(251,191,36,0.12), transparent 70%);
    filter: blur(40px);
    animation: float 10s ease-in-out infinite reverse;
  }
  
  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, -20px) scale(1.1); }
  }
  
  /* Animated number */
  .num-animate {
    background: linear-gradient(135deg, #ffffff 0%, #10d9a0 50%, #fbbf24 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  /* Progress bar */
  .progress-track {
    background: rgba(255,255,255,0.06);
    border-radius: 100px;
    overflow: hidden;
    position: relative;
  }
  .progress-fill {
    height: 100%;
    border-radius: 100px;
    position: relative;
    overflow: hidden;
    transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shimmer 2s infinite;
  }
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  
  /* Sidebar */
  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-radius: 12px;
    color: var(--muted);
    transition: all 0.2s;
    font-weight: 500;
    font-size: 14px;
    position: relative;
    cursor: pointer;
  }
  .sidebar-link:hover { 
    color: var(--fg); 
    background: rgba(255,255,255,0.03); 
  }
  .sidebar-link.active {
    color: var(--emerald);
    background: rgba(16,217,160,0.08);
  }
  .sidebar-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: var(--emerald);
    border-radius: 0 3px 3px 0;
  }
  
  /* Buttons */
  .btn-primary {
    background: linear-gradient(135deg, var(--emerald), var(--emerald-dim));
    color: #04130d;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: 12px;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(16,217,160,0.3);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(16,217,160,0.4);
  }
  
  .btn-ghost {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    color: var(--fg);
    padding: 10px 16px;
    border-radius: 12px;
    transition: all 0.2s;
    font-weight: 500;
    font-size: 14px;
  }
  .btn-ghost:hover {
    background: rgba(255,255,255,0.07);
    border-color: var(--border-strong);
  }
  
  /* Pulse animation */
  .pulse-dot {
    position: relative;
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--emerald);
    border-radius: 50%;
  }
  .pulse-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: var(--emerald);
    opacity: 0.4;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(2); opacity: 0; }
  }
  
  /* Transaction item */
  .tx-item {
    transition: all 0.2s;
    cursor: pointer;
  }
  .tx-item:hover {
    background: rgba(255,255,255,0.03);
  }
  
  /* Category pill */
  .cat-pill {
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  
  /* Toast */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--card-2);
    border: 1px solid var(--border-strong);
    padding: 14px 20px;
    border-radius: 12px;
    color: var(--fg);
    font-size: 14px;
    transform: translateX(400px);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .toast.show { transform: translateX(0); }
  
  /* Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(5, 8, 16, 0.7);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 20px;
  }
  .modal-backdrop.active { display: flex; animation: fadeIn 0.2s; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  
  .modal-content {
    background: linear-gradient(135deg, var(--card-2), var(--card));
    border: 1px solid var(--border-strong);
    border-radius: 20px;
    padding: 28px;
    width: 100%;
    max-width: 480px;
    animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  
  /* Input */
  .input-field {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 16px;
    color: var(--fg);
    width: 100%;
    font-family: inherit;
    font-size: 14px;
    transition: all 0.2s;
  }
  .input-field:focus {
    outline: none;
    border-color: var(--emerald);
    background: rgba(16,217,160,0.04);
  }
  
  /* Goal card patterns */
  .goal-pattern-1 { background: linear-gradient(135deg, rgba(16,217,160,0.15), rgba(16,217,160,0.02)); }
  .goal-pattern-2 { background: linear-gradient(135deg, rgba(251,191,36,0.15), rgba(251,191,36,0.02)); }
  .goal-pattern-3 { background: linear-gradient(135deg, rgba(167,139,250,0.15), rgba(167,139,250,0.02)); }
  .goal-pattern-4 { background: linear-gradient(135deg, rgba(56,189,248,0.15), rgba(56,189,248,0.02)); }
  
  /* Streak calendar */
  .streak-day {
    aspect-ratio: 1;
    border-radius: 6px;
    background: rgba(255,255,255,0.04);
    transition: all 0.2s;
  }
  .streak-day.active {
    background: linear-gradient(135deg, var(--emerald), var(--emerald-dim));
    box-shadow: 0 0 12px rgba(16,217,160,0.4);
  }
  .streak-day.today {
    border: 2px solid var(--gold);
    background: rgba(251,191,36,0.15);
  }
  
  /* Animated chart line */
  @keyframes drawLine {
    from { stroke-dashoffset: 1000; }
    to { stroke-dashoffset: 0; }
  }
  
  /* Responsive */
  @media (max-width: 1024px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .main-content { margin-left: 0 !important; }
  }
  
  /* Reveal animation */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: reveal 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* Tab buttons */
  .tab-btn {
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    transition: all 0.2s;
    cursor: pointer;
  }
  .tab-btn.active {
    background: rgba(255,255,255,0.06);
    color: var(--fg);
  }
  
  /* Coin spin animation for logo */
  @keyframes spin3d {
    0% { transform: rotateY(0deg); }
    100% { transform: rotateY(360deg); }
  }
  .coin-spin {
    animation: spin3d 8s linear infinite;
    transform-style: preserve-3d;
  }
</style>
</head>
<body>

<!-- Sidebar -->
<aside class="sidebar fixed left-0 top-0 h-screen w-64 z-40 flex flex-col p-5 border-r border-white/5" style="background: rgba(10,15,28,0.6); backdrop-filter: blur(20px);">
  <!-- Logo -->
  <div class="flex items-center gap-3 mb-10 px-2">
    <div class="relative w-10 h-10 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, var(--emerald), var(--gold)); box-shadow: 0 4px 20px rgba(16,217,160,0.3);">
      <span class="text-black font-bold text-lg display">T</span>
    </div>
    <div>
      <div class="font-bold text-lg display tracking-tight">TabungKu</div>
      <div class="text-xs" style="color: var(--muted-2);">Premium Saver</div>
    </div>
  </div>
  
  <!-- Navigation -->
  <nav class="flex-1 space-y-1">
    <div class="text-xs uppercase tracking-wider px-4 mb-2" style="color: var(--muted-2);">Menu</div>
    <a class="sidebar-link active"><i class="lucide lucide-layout-dashboard"></i><span>Dashboard</span></a>
    <a class="sidebar-link"><i class="lucide lucide-wallet"></i><span>Tabungan</span></a>
    <a class="sidebar-link"><i class="lucide lucide-target"></i><span>Target Goals</span></a>
    <a class="sidebar-link"><i class="lucide lucide-arrow-left-right"></i><span>Transaksi</span></a>
    <a class="sidebar-link"><i class="lucide lucide-piggy-bank"></i><span>Investasi</span></a>
    <a class="sidebar-link"><i class="lucide lucide-trending-up"></i><span>Laporan</span></a>
    
    <div class="text-xs uppercase tracking-wider px-4 mb-2 mt-6" style="color: var(--muted-2);">Lainnya</div>
    <a class="sidebar-link"><i class="lucide lucide-bell"></i><span>Notifikasi</span><span class="ml-auto text-xs px-1.5 py-0.5 rounded-full" style="background: var(--coral); color: white;">3</span></a>
    <a class="sidebar-link"><i class="lucide lucide-settings"></i><span>Pengaturan</span></a>
    <a class="sidebar-link"><i class="lucide lucide-help-circle"></i><span>Bantuan</span></a>
  </nav>
  
  <!-- Upgrade card -->
  <div class="glass p-4 mt-4 relative overflow-hidden" style="background: linear-gradient(135deg, rgba(251,191,36,0.1), rgba(16,217,160,0.05));">
    <div class="text-xs font-semibold mb-1" style="color: var(--gold);">TABUNGKU PRO</div>
    <div class="text-sm mb-3" style="color: var(--fg);">Buka analitik lanjutan & target tak terbatas</div>
    <button class="btn-primary w-full text-xs py-2">Upgrade Sekarang</button>
  </div>
</aside>

<!-- Main Content -->
<main class="main-content ml-64 relative z-10 p-6 lg:p-8">
  
  <!-- Top Bar -->
  <header class="flex items-center justify-between mb-8 reveal">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="pulse-dot"></span>
        <span class="text-xs uppercase tracking-widest" style="color: var(--muted);">Live Sync · Senin, 13 Jan 2025</span>
      </div>
      <h1 class="text-3xl font-bold display">Halo, Andra 👋</h1>
      <p class="text-sm mt-1" style="color: var(--muted);">Konsisten 47 hari menuju kebebasan finansial. Lanjutkan!</p>
    </div>
    
    <div class="flex items-center gap-3">
      <div class="relative hidden md:block">
        <i class="lucide lucide-search absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--muted-2);"></i>
        <input type="text" placeholder="Cari transaksi..." class="input-field pl-10 py-2 w-64">
      </div>
      <button class="btn-ghost flex items-center gap-2 relative">
        <i class="lucide lucide-bell"></i>
        <span class="absolute top-1 right-1 w-2 h-2 rounded-full" style="background: var(--coral);"></span>
      </button>
      <button class="btn-ghost flex items-center gap-2">
        <i class="lucide lucide-moon"></i>
      </button>
      <div class="flex items-center gap-3 pl-3 border-l border-white/10">
        <div class="text-right hidden md:block">
          <div class="text-sm font-semibold">Andra Pratama</div>
          <div class="text-xs" style="color: var(--muted);">Premium Member</div>
        </div>
        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold display" style="background: linear-gradient(135deg, var(--emerald), var(--gold)); color: #04130d;">
          AP
        </div>
      </div>
    </div>
  </header>

  <!-- Hero Balance + Quick Stats -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    
    <!-- Hero Balance Card -->
    <div class="lg:col-span-2 hero-card glass p-8 reveal" style="animation-delay: 0.1s;">
      <div class="relative z-10">
        <div class="flex items-start justify-between mb-6">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <i class="lucide lucide-wallet" style="color: var(--emerald);"></i>
              <span class="text-xs uppercase tracking-widest" style="color: var(--muted);">Total Saldo Tabungan</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl" style="color: var(--muted);">Rp</span>
              <span class="display text-5xl lg:text-6xl font-bold num-animate" id="totalBalance">0</span>
            </div>
            <div class="flex items-center gap-3 mt-3">
              <span class="cat-pill" style="background: rgba(16,217,160,0.15); color: var(--emerald);">
                <i class="lucide lucide-trending-up text-xs"></i> +12,4%
              </span>
              <span class="text-xs" style="color: var(--muted);">vs bulan lalu · +Rp 1.840.000</span>
            </div>
          </div>
          
          <div class="flex gap-2">
            <button class="btn-ghost flex items-center gap-2 text-xs" onclick="openModal('topupModal')">
              <i class="lucide lucide-plus"></i> Tambah
            </button>
            <button class="btn-ghost flex items-center gap-2 text-xs" onclick="openModal('withdrawModal')">
              <i class="lucide lucide-arrow-up-right"></i> Tarik
            </button>
          </div>
        </div>
        
        <!-- Mini Chart -->
        <div class="h-32 relative">
          <canvas id="balanceChart"></canvas>
        </div>
        
        <!-- Bottom stats -->
        <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-white/5">
          <div>
            <div class="text-xs" style="color: var(--muted);">Pemasukan Bulan Ini</div>
            <div class="display text-xl font-bold mt-1" style="color: var(--emerald);">Rp 8.450.000</div>
          </div>
          <div>
            <div class="text-xs" style="color: var(--muted);">Pengeluaran</div>
            <div class="display text-xl font-bold mt-1" style="color: var(--coral);">Rp 3.210.000</div>
          </div>
          <div>
            <div class="text-xs" style="color: var(--muted);">Tingkat Menabung</div>
            <div class="display text-xl font-bold mt-1" style="color: var(--gold);">62%</div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Quick Action Card -->
    <div class="glass p-6 reveal" style="animation-delay: 0.2s;">
      <div class="flex items-center justify-between mb-5">
        <h3 class="font-semibold display text-lg">Aksi Cepat</h3>
        <i class="lucide lucide-zap" style="color: var(--gold);"></i>
      </div>
      
      <div class="grid grid-cols-2 gap-3 mb-5">
        <button class="glass-hover glass p-4 text-left" style="background: rgba(16,217,160,0.06); border-color: rgba(16,217,160,0.15);" onclick="openModal('topupModal')">
          <i class="lucide lucide-arrow-down-circle text-2xl mb-2" style="color: var(--emerald);"></i>
          <div class="font-semibold text-sm">Setor</div>
          <div class="text-xs" style="color: var(--muted);">Tabungan</div>
        </button>
        <button class="glass-hover glass p-4 text-left" style="background: rgba(251,191,36,0.06); border-color: rgba(251,191,36,0.15);" onclick="showToast('Fitur transfer dibuka')">
          <i class="lucide lucide-send text-2xl mb-2" style="color: var(--gold);"></i>
          <div class="font-semibold text-sm">Transfer</div>
          <div class="text-xs" style="color: var(--muted);">Antar bank</div>
        </button>
        <button class="glass-hover glass p-4 text-left" style="background: rgba(167,139,250,0.06); border-color: rgba(167,139,250,0.15);" onclick="openModal('goalModal')">
          <i class="lucide lucide-target text-2xl mb-2" style="color: var(--violet);"></i>
          <div class="font-semibold text-sm">Target</div>
          <div class="text-xs" style="color: var(--muted);">Buat goal</div>
        </button>
        <button class="glass-hover glass p-4 text-left" style="background: rgba(56,189,248,0.06); border-color: rgba(56,189,248,0.15);" onclick="showToast('Analitik dibuka')">
          <i class="lucide lucide-pie-chart text-2xl mb-2" style="color: var(--sky);"></i>
          <div class="font-semibold text-sm">Analisis</div>
          <div class="text-xs" style="color: var(--muted);">Pengeluaran</div>
        </button>
      </div>
      
      <!-- Streak -->
      <div class="pt-5 border-t border-white/5">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <i class="lucide lucide-flame" style="color: var(--coral);"></i>
            <span class="text-sm font-semibold">Streak Menabung</span>
          </div>
          <span class="display font-bold" style="color: var(--gold);">47 hari</span>
        </div>
        <div class="grid grid-cols-7 gap-1.5" id="streakCalendar"></div>
        <div class="text-xs mt-2" style="color: var(--muted);">Aktif setiap hari untuk bonus +5% bunga</div>
      </div>
    </div>
  </section>

  <!-- Charts Row -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    
    <!-- Growth Chart -->
    <div class="lg:col-span-2 glass p-6 reveal" style="animation-delay: 0.3s;">
      <div class="flex items-center justify-between mb-6">
        <div>
