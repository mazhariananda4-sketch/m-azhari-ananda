      <option>Pendidikan</option>
    </select>
    
    <button class="btn-primary w-full flex items-center justify-center gap-2" onclick="submitTopUp()">
      <i class="lucide lucide-check"></i> Konfirmasi Setor
    </button>
  </div>
</div>

